#!/usr/bin/env bash
# Bir projeyi <isim>.<zone> adresinden yayina alir.
#
#   paperclip-preview port <isim>      # projeye ayrilmis sabit portu yazar
#   paperclip-preview add  <isim> [port]  # DNS + Access + nginx kurar, adresi yazar
#                                      # port verilmezse havuzdan atanir
#   paperclip-preview list             # tum preview'lar ve durumlari
#   paperclip-preview status <isim>    # tek preview: port, dinleniyor mu, adres
#   paperclip-preview rm   <isim>      # DNS kaydini, Access uygulamasini, vhost'u siler
#
# Ajanin kullanimi (sudo ile, bkz. /etc/sudoers.d/paperclip-preview):
#   PORT=$(sudo paperclip-preview port makine)   # once portu ogren
#   ... uygulamayi 127.0.0.1:$PORT uzerinde baslat ...
#   sudo paperclip-preview add makine            # sonra yayina al
#
# Port haritasi kalicidir: ayni isim her zaman ayni portu alir.
set -euo pipefail

CONF=/etc/paperclip-preview.conf
STATE_DIR=/var/lib/paperclip-preview
PORT_MAP="$STATE_DIR/ports.map"
NGINX_DIR=/etc/nginx/sites-available
NGINX_EN=/etc/nginx/sites-enabled
API=https://api.cloudflare.com/client/v4

die()  { printf '\033[1;31mHATA:\033[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }

[ "$(id -u)" -eq 0 ] || die "root olarak calistirin (ajan icin: sudo paperclip-preview ...)."
[ -r "$CONF" ] || die "$CONF okunamadi. Once Cloudflare ayarlarini girin."
# shellcheck disable=SC1090
. "$CONF"

: "${CF_API_TOKEN:?$CONF icinde CF_API_TOKEN yok}"
: "${CF_ZONE:?$CONF icinde CF_ZONE yok}"
: "${ORIGIN_IP:?$CONF icinde ORIGIN_IP yok}"
: "${PREVIEW_CERT:?$CONF icinde PREVIEW_CERT yok}"
: "${PREVIEW_KEY:?$CONF icinde PREVIEW_KEY yok}"
PORT_MIN="${PORT_MIN:-3200}"
PORT_MAX="${PORT_MAX:-3299}"
ACCESS_EMAILS="${ACCESS_EMAILS:-}"
ACCESS_ENABLED="${ACCESS_ENABLED:-1}"

# ───────────────────────── dogrulama ─────────────────────────
# Ajan bu komutu sudo ile cagirabiliyor; isim tek dogrulama noktasi oldugu icin
# dar tutuluyor. Rezerve isimler panelin ve altyapinin kendi adlarini korur.
RESERVED="asistan www api mail smtp imap pop ns1 ns2 vpn admin panel root mx autodiscover"

validate_name() {
  n="$1"
  [ -n "$n" ] || die "Isim bos olamaz."
  printf '%s' "$n" | grep -qE '^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$' \
    || die "Gecersiz isim: '$n'. Sadece kucuk harf, rakam ve tire; en fazla 32 karakter."
  for r in $RESERVED; do
    [ "$n" = "$r" ] && die "'$n' rezerve bir isim, kullanilamaz."
  done
  return 0
}

# ───────────────────────── port haritasi ─────────────────────────
lookup_port() { awk -F= -v k="$1" '$1==k{print $2; exit}' "$PORT_MAP" 2>/dev/null; }

# Altyapinin kendi portlari. Bir preview bunlara yonlendirilirse panel ya da
# veritabani yanlislikla disari acilir; ajan da bu komutu cagirabildigi icin
# liste burada zorunlu tutuluyor.
BLOCKED_PORTS="3100 54329 5432 22"

assign_port() {
  n="$1"; requested="${2:-}"
  if [ -n "$requested" ]; then
    printf '%s' "$requested" | grep -qE '^[0-9]+$' || die "Port sayi olmali: '$requested'"
    [ "$requested" -ge 1024 ] && [ "$requested" -le 65535 ] \
      || die "Port 1024-65535 araliginda olmali: $requested"
    for b in $BLOCKED_PORTS; do
      [ "$requested" = "$b" ] && die "Port $requested altyapiya ait, preview icin kullanilamaz."
    done
    owner="$(awk -F= -v v="$requested" '$2==v{print $1; exit}' "$PORT_MAP" 2>/dev/null)"
    [ -n "$owner" ] && [ "$owner" != "$n" ] && die "Port $requested zaten '$owner' icin ayrilmis."
    tmp="$(mktemp)"; grep -v "^$n=" "$PORT_MAP" > "$tmp" 2>/dev/null || true
    printf '%s=%s\n' "$n" "$requested" >> "$tmp"
    cat "$tmp" > "$PORT_MAP"; rm -f "$tmp"
    printf '%s' "$requested"; return 0
  fi
  existing="$(lookup_port "$n")"
  if [ -n "$existing" ]; then printf '%s' "$existing"; return 0; fi
  p="$PORT_MIN"
  while [ "$p" -le "$PORT_MAX" ]; do
    if ! awk -F= -v v="$p" '$2==v{found=1} END{exit !found}' "$PORT_MAP" 2>/dev/null; then
      printf '%s=%s\n' "$n" "$p" >> "$PORT_MAP"
      printf '%s' "$p"; return 0
    fi
    p=$((p+1))
  done
  die "Bos port kalmadi ($PORT_MIN-$PORT_MAX). Kullanilmayanlari 'paperclip-preview rm' ile silin."
}

port_listening() { ss -tln "sport = :$1" 2>/dev/null | grep -q LISTEN; }

# ───────────────────────── cloudflare ─────────────────────────
cf() {
  method="$1"; path="$2"; shift 2
  if [ $# -gt 0 ]; then
    curl -sS -X "$method" "$API$path" \
      -H "Authorization: Bearer $CF_API_TOKEN" \
      -H "Content-Type: application/json" --data "$1"
  else
    curl -sS -X "$method" "$API$path" \
      -H "Authorization: Bearer $CF_API_TOKEN" \
      -H "Content-Type: application/json"
  fi
}

cf_check() {
  # Cloudflare 200 icinde de basarisizlik dondurebiliyor; success alanina bak.
  printf '%s' "$1" | jq -e '.success == true' >/dev/null 2>&1 && return 0
  msg="$(printf '%s' "$1" | jq -r '[.errors[]?|"\(.code): \(.message)"]|join("; ")' 2>/dev/null)"
  die "Cloudflare: ${msg:-bilinmeyen hata} ${2:-}"
}

zone_id() {
  if [ -n "${CF_ZONE_ID:-}" ]; then printf '%s' "$CF_ZONE_ID"; return 0; fi
  r="$(cf GET "/zones?name=$CF_ZONE")"; cf_check "$r" "(zone arama)"
  z="$(printf '%s' "$r" | jq -r '.result[0].id // empty')"
  [ -n "$z" ] || die "Zone bulunamadi: $CF_ZONE (token'in Zone:Read yetkisi var mi?)"
  printf 'CF_ZONE_ID=%s\n' "$z" >> "$CONF"
  printf '%s' "$z"
}

account_id() {
  if [ -n "${CF_ACCOUNT_ID:-}" ]; then printf '%s' "$CF_ACCOUNT_ID"; return 0; fi
  r="$(cf GET "/accounts")"; cf_check "$r" "(hesap listesi)"
  a="$(printf '%s' "$r" | jq -r '.result[0].id // empty')"
  [ -n "$a" ] || die "Hesap bulunamadi (token'in Account:Read yetkisi var mi?)"
  printf 'CF_ACCOUNT_ID=%s\n' "$a" >> "$CONF"
  printf '%s' "$a"
}

dns_record_id() {
  r="$(cf GET "/zones/$(zone_id)/dns_records?type=A&name=$1")"
  cf_check "$r" "(DNS arama)"
  printf '%s' "$r" | jq -r '.result[0].id // empty'
}

dns_upsert() {
  fqdn="$1"
  body="$(jq -nc --arg n "$fqdn" --arg c "$ORIGIN_IP" \
    '{type:"A",name:$n,content:$c,proxied:true,ttl:1,comment:"paperclip-preview"}')"
  id="$(dns_record_id "$fqdn")"
  if [ -n "$id" ]; then
    r="$(cf PUT "/zones/$(zone_id)/dns_records/$id" "$body")"; cf_check "$r" "(DNS guncelleme)"
    ok "DNS kaydi guncellendi (proxied): $fqdn -> $ORIGIN_IP"
  else
    r="$(cf POST "/zones/$(zone_id)/dns_records" "$body")"; cf_check "$r" "(DNS olusturma)"
    ok "DNS kaydi olusturuldu (proxied): $fqdn -> $ORIGIN_IP"
  fi
}

dns_delete() {
  id="$(dns_record_id "$1")"
  if [ -n "$id" ]; then
    r="$(cf DELETE "/zones/$(zone_id)/dns_records/$id")"; cf_check "$r" "(DNS silme)"
    ok "DNS kaydi silindi: $1"
  else
    warn "DNS kaydi zaten yok: $1"
  fi
}

access_app_id() {
  r="$(cf GET "/accounts/$(account_id)/access/apps")"
  cf_check "$r" "(Access uygulama listesi)"
  printf '%s' "$r" | jq -r --arg d "$1" '.result[]? | select(.domain==$d) | .id' | head -1
}

access_setup() {
  fqdn="$1"
  [ "$ACCESS_ENABLED" = "1" ] || { warn "Access kapali (ACCESS_ENABLED=0) — $fqdn HERKESE ACIK olacak."; return 0; }
  [ -n "$ACCESS_EMAILS" ] || { warn "ACCESS_EMAILS bos — Access kurulmadi, $fqdn HERKESE ACIK."; return 0; }

  existing="$(access_app_id "$fqdn")"
  if [ -n "$existing" ]; then ok "Access uygulamasi zaten var: $fqdn"; return 0; fi

  body="$(jq -nc --arg n "paperclip preview: $fqdn" --arg d "$fqdn" \
    '{name:$n,domain:$d,type:"self_hosted",session_duration:"24h",
      app_launcher_visible:false,allowed_idps:[],auto_redirect_to_identity:false}')"
  r="$(cf POST "/accounts/$(account_id)/access/apps" "$body")"; cf_check "$r" "(Access uygulama)"
  app="$(printf '%s' "$r" | jq -r '.result.id')"

  includes="$(printf '%s' "$ACCESS_EMAILS" | tr ',' '\n' | sed '/^[[:space:]]*$/d' \
    | jq -R '{email:{email:(.|gsub("^\\s+|\\s+$";""))}}' | jq -sc '.')"
  pol="$(jq -nc --argjson inc "$includes" \
    '{name:"izinli e-postalar",decision:"allow",include:$inc,precedence:1}')"
  r="$(cf POST "/accounts/$(account_id)/access/apps/$app/policies" "$pol")"
  cf_check "$r" "(Access politikasi)"
  ok "Cloudflare Access kuruldu — sadece: $ACCESS_EMAILS"
}

access_delete() {
  [ "$ACCESS_ENABLED" = "1" ] || return 0
  id="$(access_app_id "$1")"
  if [ -n "$id" ]; then
    r="$(cf DELETE "/accounts/$(account_id)/access/apps/$id")"; cf_check "$r" "(Access silme)"
    ok "Access uygulamasi silindi: $1"
  fi
}

# ───────────────────────── nginx ─────────────────────────
vhost_write() {
  name="$1"; fqdn="$2"; port="$3"
  cat > "$NGINX_DIR/preview-$name.conf" <<VHOST
# paperclip-preview: $fqdn -> 127.0.0.1:$port
# Bu dosya 'paperclip-preview' tarafindan uretilir; elle duzenlemeyin.
server {
    listen 443 ssl;
    http2 on;
    server_name $fqdn;

    ssl_certificate     $PREVIEW_CERT;
    ssl_certificate_key $PREVIEW_KEY;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    client_max_body_size 512m;

    access_log /var/log/nginx/preview-$name.access.log;
    error_log  /var/log/nginx/preview-$name.error.log warn;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;

        # Dev sunucularin cogu HMR icin WebSocket kullanir.
        proxy_set_header Upgrade    \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;

        proxy_set_header Host              \$host;
        proxy_set_header X-Real-IP         \$remote_addr;
        proxy_set_header X-Forwarded-For   \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 10s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
        proxy_buffering off;

        # Uygulama henuz ayakta degilse anlasilir bir sayfa dondur.
        proxy_intercept_errors on;
        error_page 502 503 504 = @notready;
    }

    location @notready {
        default_type text/html;
        return 503 '<!doctype html><meta charset=utf-8><title>Hazir degil</title><body style="font-family:system-ui;max-width:40rem;margin:4rem auto;padding:0 1rem"><h1>Uygulama henuz calismiyor</h1><p><code>$fqdn</code> icin <code>127.0.0.1:$port</code> dinlenmiyor.</p><p>Uygulamayi bu porta baglayin, sonra sayfayi yenileyin.</p></body>';
    }
}
VHOST
  ln -sf "$NGINX_DIR/preview-$name.conf" "$NGINX_EN/preview-$name.conf"
  nginx -t >/dev/null 2>&1 || { rm -f "$NGINX_EN/preview-$name.conf"; nginx -t; die "nginx yapilandirmasi gecersiz, geri alindi."; }
  systemctl reload nginx
  ok "nginx: $fqdn -> 127.0.0.1:$port"
}

vhost_delete() {
  rm -f "$NGINX_EN/preview-$1.conf" "$NGINX_DIR/preview-$1.conf"
  nginx -t >/dev/null 2>&1 && systemctl reload nginx
  ok "nginx vhost silindi: $1"
}

# ───────────────────────── komutlar ─────────────────────────
cmd="${1:-list}"
case "$cmd" in
  port)
    validate_name "${2:-}"
    assign_port "$2" "${3:-}"; echo
    ;;

  add)
    validate_name "${2:-}"
    name="$2"; port="$(assign_port "$name" "${3:-}")"; fqdn="$name.$CF_ZONE"
    [ -s "$PREVIEW_CERT" ] || die "Sertifika yok: $PREVIEW_CERT"
    [ -s "$PREVIEW_KEY" ]  || die "Anahtar yok: $PREVIEW_KEY"

    vhost_write "$name" "$fqdn" "$port"
    dns_upsert "$fqdn"
    access_setup "$fqdn"

    echo
    if port_listening "$port"; then
      ok "Adres: https://$fqdn  (127.0.0.1:$port dinleniyor)"
    else
      warn "127.0.0.1:$port henuz dinlenmiyor — uygulamayi bu porta baglayin."
      echo "  Adres hazir: https://$fqdn"
    fi
    ;;

  rm|remove|del)
    validate_name "${2:-}"
    name="$2"; fqdn="$name.$CF_ZONE"
    vhost_delete "$name"
    dns_delete "$fqdn"
    access_delete "$fqdn"
    # Port rezervasyonu korunur: ayni proje tekrar acildiginda ayni portu alsin.
    p="$(lookup_port "$name")"
    [ -n "$p" ] && echo "  (port $p bu isme ayrilmis kaldi; 'forget' ile serbest birakin)"
    ;;

  forget)
    validate_name "${2:-}"
    tmp="$(mktemp)"; grep -v "^$2=" "$PORT_MAP" > "$tmp" 2>/dev/null || true
    cat "$tmp" > "$PORT_MAP"; rm -f "$tmp"
    ok "Port rezervasyonu serbest birakildi: $2"
    ;;

  status)
    validate_name "${2:-}"
    p="$(lookup_port "$2")"
    [ -n "$p" ] || die "'$2' icin ayrilmis port yok."
    printf 'isim   : %s\nadres  : https://%s.%s\nport   : %s\ndurum  : %s\nvhost  : %s\n' \
      "$2" "$2" "$CF_ZONE" "$p" \
      "$(port_listening "$p" && echo "dinleniyor" || echo "DINLENMIYOR")" \
      "$([ -e "$NGINX_EN/preview-$2.conf" ] && echo "kurulu" || echo "yok")"
    ;;

  list)
    if [ ! -s "$PORT_MAP" ]; then echo "Hic preview yok."; exit 0; fi
    printf '%-20s %-7s %-12s %-9s %s\n' ISIM PORT DURUM VHOST ADRES
    while IFS='=' read -r n p; do
      [ -n "$n" ] || continue
      printf '%-20s %-7s %-12s %-9s https://%s.%s\n' "$n" "$p" \
        "$(port_listening "$p" && echo dinleniyor || echo -)" \
        "$([ -e "$NGINX_EN/preview-$n.conf" ] && echo kurulu || echo -)" \
        "$n" "$CF_ZONE"
    done < "$PORT_MAP"
    ;;

  -h|--help) sed -n '2,18p' "$0" ;;
  *) die "Bilinmeyen komut: $cmd (port|add|rm|forget|status|list)" ;;
esac
